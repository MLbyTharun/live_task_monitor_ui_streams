# UI-stream testing project — no RTSP camera URLs are needed.
# Copy to .env and fill in. `ltm check` reports anything still missing.

# ── Vision model (OpenAI-compatible endpoint) ────────────────────────────────
# vLLM:      http://gpu-box:8000/v1        model: Qwen/Qwen3-VL-2B-Instruct
# Ollama:    http://localhost:11434/v1     model: qwen3-vl:2b
# OpenRouter https://openrouter.ai/api/v1  model: <the VL model id you want>
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# For a no-model stream test, set vision.provider: mock in config/config.yaml.
# HyperReality is optional in this testing project (tasks.source: static).
HR_BASE_URL=https://stg.hyperreality.app
HR_TOKEN=
HR_ORG_ID=
HR_PROJECT_ID=
HR_ACTION_BLOCK_ID=

# Optional shared secret required by POST /api/ingest/{stream_id}
INGEST_TOKEN=

# No CAM1_URL / CAM2_URL / RTSP values are used in this project.
